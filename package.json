{
  "name": "casper-ai",
  "version": "0.0.1",
  "private": true,
  "description": "Ghostly247 — friendly browser extension that grows solo creators' Twitter/X presence.",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "dev:landing": "pnpm --filter @casper/landing-page dev",
    "dev:server": "pnpm --filter @casper/server dev",
    "dev:ext": "pnpm --filter @casper/extension dev",
    "dev:admin": "pnpm --filter @casper/admin dev",
    "build:landing": "pnpm --filter @casper/landing-page build",
    "build:server": "pnpm --filter @casper/server build",
    "build:ext": "pnpm --filter @casper/extension build",
    "build:admin": "pnpm --filter @casper/admin build",
    "build:shared": "pnpm --filter @casper/shared build",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css}\" --ignore-path .gitignore"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "typescript": "^5.7.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "sharp"]
  }
}
