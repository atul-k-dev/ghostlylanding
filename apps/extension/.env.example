# Used by content scripts + service worker via import.meta.env
VITE_API_BASE_URL=http://localhost:4000

# Google OAuth 2.0 Web Application client ID.
# Same value as GOOGLE_CLIENT_ID on the server. Authorized redirect URI must be:
#   https://<your-extension-id>.chromiumapp.org/
VITE_GOOGLE_CLIENT_ID=231605857864-kqebq6jrf2stj6g2h15dlhb4l0r9at6j.apps.googleusercontent.com

# The website (invite + welcome pages). Local builds also let localhost:3000
# message the extension; store builds allow only this site.
VITE_SITE_URL=http://localhost:3000
