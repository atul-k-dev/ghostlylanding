{
  "name": "@casper/extension",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "package": "pnpm build && mkdir -p ../../releases && rm -f \"../../releases/ghostly247-extension-$npm_package_version.zip\" && (cd dist && zip -qr \"../../../releases/ghostly247-extension-$npm_package_version.zip\" .) && echo \"-> releases/ghostly247-extension-$npm_package_version.zip\"",
    "preview": "vite preview",
    "test": "pnpm smoke && pnpm reply-queue-smoke && pnpm relevance-smoke && pnpm selectors-smoke && pnpm schedule-smoke && pnpm resilience-smoke && pnpm block-reason-smoke && pnpm pacing-smoke && pnpm presets-smoke && pnpm setup-smoke && pnpm conditions-smoke && pnpm floating-smoke && pnpm mentions-smoke && pnpm browser-notify-smoke && pnpm best-times-smoke && pnpm trust-smoke && pnpm quote-card-smoke && pnpm follow-filter-smoke && pnpm attribution-smoke && pnpm auto-tune-smoke && pnpm proactive-smoke && pnpm voice-tune-smoke",
    "smoke": "tsx scripts/scheduler-smoke.mts",
    "reply-queue-smoke": "tsx scripts/reply-queue-smoke.mts",
    "relevance-smoke": "tsx scripts/relevance-smoke.mts",
    "selectors-smoke": "tsx scripts/selectors-smoke.mts",
    "schedule-smoke": "tsx scripts/schedule-smoke.mts",
    "resilience-smoke": "tsx scripts/resilience-smoke.mts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist",
    "block-reason-smoke": "tsx scripts/block-reason-smoke.mts",
    "pacing-smoke": "tsx scripts/pacing-smoke.mts",
    "presets-smoke": "tsx scripts/presets-smoke.mts",
    "setup-smoke": "tsx scripts/setup-smoke.mts",
    "conditions-smoke": "tsx scripts/conditions-smoke.mts",
    "floating-smoke": "tsx scripts/floating-smoke.mts",
    "mentions-smoke": "tsx scripts/mentions-smoke.mts",
    "browser-notify-smoke": "tsx scripts/browser-notify-smoke.mts",
    "best-times-smoke": "tsx scripts/best-times-smoke.mts",
    "trust-smoke": "tsx scripts/trust-smoke.mts",
    "quote-card-smoke": "tsx scripts/quote-card-smoke.mts",
    "follow-filter-smoke": "tsx scripts/follow-filter-smoke.mts",
    "attribution-smoke": "tsx scripts/attribution-smoke.mts",
    "auto-tune-smoke": "tsx scripts/auto-tune-smoke.mts",
    "proactive-smoke": "tsx scripts/proactive-smoke.mts",
    "voice-tune-smoke": "tsx scripts/voice-tune-smoke.mts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@casper/shared": "workspace:*",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@hugeicons/core-free-icons": "^4.3.2",
    "@hugeicons/react": "^1.1.10",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.34",
    "@tailwindcss/vite": "^4.0.0",
    "@types/chrome": "^0.0.290",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
