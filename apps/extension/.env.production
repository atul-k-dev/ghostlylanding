# Production build config — used by `vite build` (mode=production), which is what
# `pnpm package` runs to produce the Chrome Web Store zip. Overrides `.env`
# (localhost) for release builds only; `pnpm dev` still points at localhost.
#
# No secrets here: the OAuth client ID is public by design, and this file is
# tracked so a store build is reproducible instead of depending on whatever
# happened to be in someone's untracked .env.

VITE_API_BASE_URL=https://api.ghostly247.com

# Must match GOOGLE_CLIENT_ID on the server. The redirect URI is derived at
# runtime from the extension's own ID via chrome.identity.getRedirectURL(), so
# Google Cloud must authorize the PUBLISHED extension's URI:
#   https://olfnjmpoacjchlklmdlaimpckblmokga.chromiumapp.org/
VITE_GOOGLE_CLIENT_ID=231605857864-kqebq6jrf2stj6g2h15dlhb4l0r9at6j.apps.googleusercontent.com

# The website: /welcome opens on first install, and its /invite and /welcome
# pages are the only pages allowed to message the extension.
VITE_SITE_URL=https://ghostly247.com
