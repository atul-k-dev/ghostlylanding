NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Set this once the extension is published — all landing-page CTAs point here.
NEXT_PUBLIC_CHROME_WEB_STORE_URL=
