# Server
PORT=4000
NODE_ENV=development
LOG_LEVEL=debug

# Database (MongoDB Atlas)
MONGODB_URI=
# Connection-pool tunables. Atlas free tier has a 500-connection global cap;
# 50/node is the right default until you scale horizontally.
MONGO_MAX_POOL_SIZE=10
MONGO_MIN_POOL_SIZE=2

# Auth
JWT_SECRET=
JWT_EXPIRES_IN=30d
BCRYPT_ROUNDS=12

# Google Sign-In — OAuth 2.0 Web Application client ID from Google Cloud Console.
# Add https://<extension-id>.chromiumapp.org/ to its Authorized redirect URIs.
GOOGLE_CLIENT_ID=

# CORS — comma-separated origins allowed (Chrome extension + web)
ALLOWED_ORIGINS=http://localhost:3000

# OpenAI
OPENAI_API_KEY=

# Resend (transactional emails)
# For testing without a verified domain, the ONLY allowed sender is
# onboarding@resend.dev (other @resend.dev addresses are rejected), and Resend
# will only deliver to your Resend account's own email. To send to anyone / from
# your own address, verify a domain at resend.com/domains.
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

# Landing page base URL
LANDING_BASE_URL=http://localhost:3000

# Server's own public base URL — Stripe post-checkout redirects land here
SERVER_BASE_URL=http://localhost:4000

# Public website — invite links are <SITE_URL>/invite/<code>, and its origin is
# allowed through CORS. Production default: https://www.ghostly247.com (the
# canonical host; the bare domain redirects to it).
SITE_URL=http://localhost:3000

# Stripe — leave blank to disable billing endpoints
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Single monthly Price ID for Casper Pro
STRIPE_PRICE_WEEKLY=
STRIPE_PRICE_MONTHLY=
# Admin revenue only counts this Stripe product (the account is shared)
STRIPE_PRODUCT_NAME=Ghostly247 Pro
