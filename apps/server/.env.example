# Server
PORT=4000
NODE_ENV=development
LOG_LEVEL=debug

# Database (MongoDB Atlas)
MONGODB_URI=

# Auth
JWT_SECRET=
JWT_EXPIRES_IN=30d
BCRYPT_ROUNDS=12

# Google Sign-In — OAuth 2.0 Web Application client ID from Google Cloud Console.
# Add https://<extension-id>.chromiumapp.org/ to its Authorized redirect URIs.
GOOGLE_CLIENT_ID=

# CORS — comma-separated origins allowed (Chrome extension + web)
ALLOWED_ORIGINS=http://localhost:3000

# OpenAI (used from M5 onward)
OPENAI_API_KEY=

# Resend (transactional emails — daily summaries, password resets, etc.)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Landing page base URL — magic-link verify page lives here
LANDING_BASE_URL=http://localhost:3000

# Server's own public base URL — Stripe post-checkout redirects land here
SERVER_BASE_URL=http://localhost:4000

# Stripe — leave blank to disable billing endpoints
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# One Price ID per billing cycle (see CONTEXT.md §8)
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_QUARTERLY=
STRIPE_PRICE_ANNUAL=
