{
  "name": "@casper/server",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:memory": "tsx scripts/dev-memory.mts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "pnpm growth-smoke && pnpm voice-smoke && pnpm daily-summary-smoke && pnpm weekly-summary-smoke && pnpm digest-claim-smoke && pnpm ask-tools-smoke && pnpm referral-smoke",
    "smoke": "tsx scripts/smoke.mts",
    "growth-smoke": "tsx scripts/growth-smoke.mts",
    "voice-smoke": "tsx scripts/voice-smoke.mts",
    "daily-summary-smoke": "tsx scripts/daily-summary-smoke.mts",
    "weekly-summary-smoke": "tsx scripts/weekly-summary-smoke.mts",
    "digest-claim-smoke": "tsx scripts/digest-claim-smoke.mts",
    "ask-tools-smoke": "tsx scripts/ask-tools-smoke.mts",
    "referral-smoke": "tsx scripts/referral-smoke.mts",
    "fix-diagnostic-index": "tsx scripts/fix-diagnostic-index.mts",
    "set-pro": "tsx scripts/set-pro.mts",
    "set-admin": "tsx scripts/set-admin.mts",
    "create-admin": "tsx scripts/create-admin.mts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@casper/shared": "workspace:*",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "google-auth-library": "^9.15.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "openai": "^4.77.0",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "resend": "^4.0.1",
    "stripe": "^17.5.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.0",
    "mongodb-memory-server": "^11.3.0",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
