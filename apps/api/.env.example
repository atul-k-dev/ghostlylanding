# Server
PORT=4000
NODE_ENV=development
LOG_LEVEL=debug

# Database (MongoDB Atlas)
MONGODB_URI=

# Auth
JWT_SECRET=
JWT_EXPIRES_IN=30d
MAGIC_LINK_TTL_MINUTES=15

# CORS — comma-separated origins allowed (Chrome extension + web)
ALLOWED_ORIGINS=http://localhost:3000

# OpenAI (used from M5 onward)
OPENAI_API_KEY=

# Resend (magic links + transactional)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Web app base URL (magic-link redirect lands here)
WEB_BASE_URL=http://localhost:3000

# Stripe — leave blank to disable billing endpoints
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# One Price ID per billing cycle (see CONTEXT.md §8)
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_QUARTERLY=
STRIPE_PRICE_ANNUAL=
